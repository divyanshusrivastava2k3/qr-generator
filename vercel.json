{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "default.png", "use": "@vercel/static" },
    { "src": "doraemon.png", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/default.png", "dest": "/default.png" },
    { "src": "/doraemon.png", "dest": "/doraemon.png" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
