{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "g.png", "use": "@vercel/static" },
    { "src": "d.png", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/g.png", "dest": "/g.png" },
    { "src": "/d.png", "dest": "/d.png" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
